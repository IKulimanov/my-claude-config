{
  "_comment": "Хуки и permissions личного конфига. Логирующие хуки async: замер 2026-09-04 — 51 мс на хук, два на каждый вызов инструмента. HOOKS_DIR подменяется на абсолютный путь при установке (scripts/install-hooks.sh --write или scripts/setup-global.sh install --apply). Логи — $HOME/.claude/logs/*.jsonl.",
  "_install": "scripts/install-hooks.sh --write сливает секции hooks и permissions.deny/ask в ~/.claude/settings.json с бэкапом; allow не трогает. Описание хуков — docs/TECHNICAL.md.",

  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.kube/config)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Bash(git push*)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git pull*)"
    ],
    "ask": [
      "Edit(**/.gitlab-ci.yml)",
      "Write(**/.gitlab-ci.yml)",
      "MultiEdit(**/.gitlab-ci.yml)",
      "Edit(**/.gitlab/**)",
      "Write(**/.gitlab/**)",
      "MultiEdit(**/.gitlab/**)",
      "Edit(**/helm/**)",
      "Write(**/helm/**)",
      "MultiEdit(**/helm/**)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/block-destructive.sh", "timeout": 10 },
          { "type": "command", "command": "HOOKS_DIR/guard-git.sh", "timeout": 10 },
          { "type": "command", "command": "HOOKS_DIR/check-commit-msg.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/guard-paths.sh", "timeout": 10 },
          { "type": "command", "command": "HOOKS_DIR/guard-tests.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/guard-scope.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/block-secrets.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-tool.sh pre", "timeout": 5, "async": true }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-tool.sh post", "timeout": 5, "async": true }
        ]
      }
    ],

    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-tool.sh fail", "timeout": 5, "async": true }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-prompt.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-session.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-session.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-subagent.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-subagent.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-instructions.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/notify-stop.sh", "timeout": 5, "async": true },
          { "type": "command", "command": "HOOKS_DIR/log-stop.sh", "timeout": 15, "async": true }
        ]
      }
    ]
  }
}
