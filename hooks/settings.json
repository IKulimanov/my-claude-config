{
  "_comment": "Hook config for personal claude-config. Replace HOOKS_DIR via sed before installing, or set CLAUDE_HOOKS_DIR=/abs/path/to/my-claude-config/hooks/scripts in env. Logs land in $HOME/.claude/logs/*.jsonl.",
  "_install": "См. docs/HOOKS_GUIDE.md → 'Установка'. Кратко: sed -e 's|HOOKS_DIR|/Users/ivankulimanov/dev/my-claude-config/hooks/scripts|g' hooks/settings.json > ~/.claude/settings.json (merge с существующим).",

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/block-destructive.sh", "timeout": 10 },
          { "type": "command", "command": "HOOKS_DIR/block-push-secrets.sh", "timeout": 60 }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/block-secrets.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-tool.sh pre", "timeout": 5 }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-tool.sh post", "timeout": 5 }
        ]
      }
    ],

    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-tool.sh fail", "timeout": 5 }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-prompt.sh", "timeout": 5 }
        ]
      }
    ],

    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-session.sh", "timeout": 5 }
        ]
      }
    ],

    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-session.sh", "timeout": 5 }
        ]
      }
    ],

    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-subagent.sh", "timeout": 5 }
        ]
      }
    ],

    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-subagent.sh", "timeout": 5 }
        ]
      }
    ],

    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-instructions.sh", "timeout": 5 }
        ]
      }
    ],

    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/notify-stop.sh", "timeout": 5 },
          { "type": "command", "command": "HOOKS_DIR/log-stop.sh", "timeout": 15 }
        ]
      }
    ]
  }
}
