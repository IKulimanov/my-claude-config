{
  "_comment": "Базовые настройки, которые ставит install-hooks.sh: hooks + permissions + cleanupPeriodDays. Плейсхолдер HOOKS_DIR подменяется на абсолютный путь при установке. Логи пишутся в $HOME/.claude/logs/*.jsonl.",
  "_install": "См. docs/HOOKS_GUIDE.md → 'Установка'. Обычный путь: scripts/setup-global.sh install --apply (он вызывает scripts/install-hooks.sh --write, который сам подставляет пути и мержит в ~/.claude/settings.json с бэкапом).",

  "cleanupPeriodDays": 90,

  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.kube/config)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/block-destructive.sh", "timeout": 10 },
          { "type": "command", "command": "HOOKS_DIR/block-push-secrets.sh", "timeout": 60 }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/block-secrets.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-tool.sh pre", "timeout": 5, "async": true }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-tool.sh post", "timeout": 5, "async": true }
        ]
      }
    ],

    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-tool.sh fail", "timeout": 5, "async": true }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-prompt.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-session.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-session.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-subagent.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-subagent.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/log-instructions.sh", "timeout": 5, "async": true }
        ]
      }
    ],

    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "HOOKS_DIR/notify-stop.sh", "timeout": 5, "async": true },
          { "type": "command", "command": "HOOKS_DIR/log-stop.sh", "timeout": 15, "async": true }
        ]
      }
    ]
  }
}
