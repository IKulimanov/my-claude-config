CREATE USER ienergy 
IDENTIFIED BY "qwerty123";


CREATE TABLESPACE IENERGY_TBS
DATAFILE '+DATA002/techdwh/ienergy_tbs01.dbf'
SIZE 10M
AUTOEXTEND ON NEXT 100M MAXSIZE UNLIMITED

ALTER USER ienergy 
  DEFAULT TABLESPACE IENERGY_TBS
  TEMPORARY TABLESPACE TEMP
  QUOTA UNLIMITED ON IENERGY_TBS;
  

GRANT CONNECT TO ienergy;
GRANT CREATE SESSION TO ienergy;


GRANT CREATE TABLE TO ienergy;
GRANT CREATE INDEX TO ienergy;
GRANT CREATE VIEW TO ienergy;
GRANT CREATE SEQUENCE TO ienergy;
GRANT SELECT ANY TABLE TO ienergy;
GRANT DELETE ANY TABLE TO ienergy;


GRANT CREATE PROCEDURE TO ienergy;
GRANT CREATE TRIGGER TO ienergy;
GRANT CREATE SYNONYM TO ienergy;
(GRANT CREATE PUBLIC SYNONYM TO ienergy;)
GRANT CREATE MATERIALIZED VIEW TO ienergy;
GRANT INSERT ANY TABLE TO ienergy;
GRANT UPDATE ANY TABLE TO ienergy;
GRANT DELETEANY TABLE TO ienergy;

GRANT CREATE JOB TO ienergy;
GRANT CREATE PROCEDURE TO ienergy;
GRANT CREATE DATABASE LINK TO IENERGY;