CREATE USER external_prod WITH LOGIN PASSWORD 'qwerty123';

GRANT "credit_prod_role" TO "external_prod ";
REVOKE "credit_prod_role" FROM "external_prod";

-- ��������� ��������
SELECT usename FROM pg_user WHERE usename LIKE 'external_prod_%';


- - ������� �����
CREATE SCHEMA AUTHORIZATION external_prod;

- - ��������� ��������
SELECT schema_name FROM information_schema.schemata
WHERE schema_name LIKE 'external_prod_%';


-- 3. ������ ���� �� �����
GRANT USAGE ON SCHEMA external_prod TO external_prod;
GRANT CREATE ON SCHEMA external_prod TO external_prod;

-- ������ ����� �� ��� ������������ ������� � ����� external_prod
-- (SELECT, INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER)
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA external_prod TO external_prod;

-- ������ ����� �� ��� ������� ������� � ����� external_prod
ALTER DEFAULT PRIVILEGES IN SCHEMA external_prod 
    GRANT ALL PRIVILEGES ON TABLES TO external_prod;
    
    
    -- ����� �� ��� ������������ ������������������ (sequences)
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA external_prod TO external_prod;

-- ����� �� ��� ������� ������������������
ALTER DEFAULT PRIVILEGES IN SCHEMA external_prod 
    GRANT ALL PRIVILEGES ON SEQUENCES TO external_prod;
