<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Аналитика Claude Code</title>
<style>
  /* Палитра: reference-инстанс dataviz-метода (валидирована в обоих режимах). */
  :root {
    --page: #f9f9f7; --surface: #fcfcfb;
    --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
    --grid: #e1e0d9; --axis: #c3c2b7; --border: rgba(11,11,11,.10);
    --s1: #2a78d6; --s2: #1baf7a; --s3: #eda100;
    --good: #006300; --bad: #d03b3b;
    --seq0: #cde2fb; --seq1: #9ec5f4; --seq2: #6da7ec; --seq3: #3987e5;
    --seq4: #256abf; --seq5: #184f95; --seq6: #0d366b;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #0d0d0d; --surface: #1a1a19;
      --ink: #ffffff; --ink-2: #c3c2b7; --muted: #898781;
      --grid: #2c2c2a; --axis: #383835; --border: rgba(255,255,255,.10);
      --s1: #3987e5; --s2: #199e70; --s3: #c98500;
      --good: #0ca30c; --bad: #d03b3b;
    }
  }
  * { box-sizing: border-box; margin: 0; }
  body {
    background: var(--page); color: var(--ink);
    font: 14px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif;
    padding: 24px; max-width: 1180px; margin: 0 auto;
  }
  h1 { font-size: 20px; font-weight: 650; }
  h2 { font-size: 13px; font-weight: 600; color: var(--ink-2); margin-bottom: 8px; }
  .sub { color: var(--muted); font-size: 12px; margin: 4px 0 20px; }
  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 14px 16px;
  }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 18px; }
  .tile .label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .tile .value { font-size: 24px; font-weight: 650; margin-top: 2px; }
  .tile .delta { font-size: 12px; color: var(--ink-2); margin-top: 2px; }
  .delta.up-bad, .delta.down-good { font-weight: 600; }
  .up-bad { color: var(--bad); } .down-good { color: var(--good); }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 14px; margin-bottom: 18px; }
  svg { display: block; width: 100%; height: auto; }
  svg text { font: 10.5px system-ui, -apple-system, "Segoe UI", sans-serif; fill: var(--muted); }
  svg .dl { fill: var(--ink-2); font-weight: 600; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; font-size: 11px; color: var(--muted); font-weight: 500; padding: 3px 6px; border-bottom: 1px solid var(--grid); }
  td { padding: 4px 6px; border-bottom: 1px solid var(--grid); font-variant-numeric: tabular-nums; }
  td.num, th.num { text-align: right; }
  td.name { color: var(--ink); }
  tr:last-child td { border-bottom: none; }
  .advice { white-space: pre-wrap; font-size: 13.5px; color: var(--ink-2); }
  .advice h3 { font-size: 13px; color: var(--ink); margin: 10px 0 4px; }
  #tooltip {
    position: fixed; pointer-events: none; z-index: 10; display: none;
    background: var(--ink); color: var(--page); border-radius: 6px;
    padding: 6px 9px; font-size: 12px; line-height: 1.5; max-width: 260px;
  }
  footer { color: var(--muted); font-size: 12px; margin-top: 24px; }
  code { background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: 1px 5px; font-size: 11.5px; }
</style>
</head>
<body>

<h1>Аналитика Claude Code</h1>
<p class="sub" id="subtitle"></p>

<div class="tiles" id="tiles"></div>

<div class="grid2">
  <div class="card"><h2>Сессии по неделям</h2><div id="ch-sessions"></div></div>
  <div class="card"><h2>Токены (output) по неделям</h2><div id="ch-tokens"></div></div>
  <div class="card"><h2>TDD: доля правок в тестах, %</h2><div id="ch-tdd"></div></div>
  <div class="card"><h2>Фрикция: промты-коррекции</h2><div id="ch-friction"></div></div>
  <div class="card"><h2>Ошибки инструментов</h2><div id="ch-failures"></div></div>
  <div class="card"><h2>Активность по дням</h2><div id="ch-heatmap"></div></div>
</div>

<div class="grid2">
  <div class="card"><h2>Инструменты — последняя неделя</h2><div id="t-tools"></div></div>
  <div class="card"><h2>Slash-команды и skills</h2><div id="t-slash"></div></div>
  <div class="card"><h2>Субагенты</h2><div id="t-subagents"></div></div>
  <div class="card"><h2>Проекты по токенам (in+out)</h2><div id="t-projects"></div></div>
</div>

<div class="card" style="margin-bottom:18px">
  <h2>Совет недели (из последнего отчёта)</h2>
  <div class="advice" id="advice"></div>
</div>

<footer>
  Перегенерация: <code>scripts/render-dashboard.sh</code> ·
  полный цикл: <code>scripts/run-weekly-review.sh</code> ·
  отчёты: <code>analytics/reports/</code>
</footer>

<div id="tooltip"></div>

<script type="application/json" id="analytics-data">
__ANALYTICS_DATA__
</script>

<script>
(function () {
  "use strict";
  var DATA = JSON.parse(document.getElementById("analytics-data").textContent);
  var weeks = DATA.weeks || [];
  if (!weeks.length) { document.getElementById("subtitle").textContent = "Нет данных."; return; }
  var last = weeks[weeks.length - 1];
  var prev = weeks.length > 1 ? weeks[weeks.length - 2] : null;

  // Цвета отдаём как var(--x) в inline-стилях: SVG следует смене темы «вживую»,
  // без пересборки (getComputedStyle зафиксировал бы тему момента загрузки).
  function v(name) { return "var(" + name + ")"; }

  function fmt(n) {
    if (n == null) return "–";
    if (Math.abs(n) >= 1e6) return (n / 1e6).toFixed(1).replace(".", ",") + " млн";
    if (Math.abs(n) >= 1e4) return Math.round(n / 1e3) + " тыс";
    return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, " ");
  }
  function pct(cur, old) {
    if (old == null || old === 0) return "";
    var d = Math.round((cur - old) / old * 100);
    return (d >= 0 ? "↑ +" : "↓ ") + d + "% к пред.";
  }

  // --- Подзаголовок ---
  document.getElementById("subtitle").textContent =
    "Неделя " + last.week + " · " + last.range.from.slice(0, 10) + " — " +
    new Date(new Date(last.range.to) - 864e5).toISOString().slice(0, 10) +
    " (Сб–Пт UTC) · собрано " + last.generated_at.slice(0, 16).replace("T", " ") + " UTC";

  // --- Плитки ---
  // invert=true: рост метрики — плохо (фрикция, ошибки).
  var tiles = [
    { label: "Сессии", cur: last.sessions.total, old: prev && prev.sessions.total },
    { label: "Токены out", cur: last.tokens.output, old: prev && prev.tokens.output },
    { label: "Turns", cur: last.tokens.turns, old: prev && prev.tokens.turns },
    { label: "Активные дни", cur: last.active_days, old: prev && prev.active_days },
    { label: "Ошибки тулов", cur: last.tools.failures_total, old: prev && prev.tools.failures_total, invert: true },
    { label: "Фрикция", cur: last.friction.total, old: prev && prev.friction.total, invert: true }
  ];
  document.getElementById("tiles").innerHTML = tiles.map(function (t) {
    var d = pct(t.cur, t.old);
    var cls = "delta";
    if (d && t.invert) cls += d.indexOf("↑") === 0 ? " up-bad" : " down-good";
    return '<div class="card tile"><div class="label">' + t.label + '</div>' +
      '<div class="value">' + fmt(t.cur) + '</div>' +
      '<div class="' + cls + '">' + (d || "&nbsp;") + "</div></div>";
  }).join("");

  // --- Tooltip ---
  var tip = document.getElementById("tooltip");
  function showTip(evt, html) {
    tip.innerHTML = html; tip.style.display = "block";
    var x = Math.min(evt.clientX + 12, window.innerWidth - tip.offsetWidth - 8);
    tip.style.left = x + "px"; tip.style.top = (evt.clientY + 12) + "px";
  }
  function hideTip() { tip.style.display = "none"; }

  // --- SVG-хелперы ---
  var W = 520, H = 190, PAD = { l: 44, r: 10, t: 12, b: 22 };
  function svgEl(tag, attrs) {
    var el = document.createElementNS("http://www.w3.org/2000/svg", tag);
    for (var k in attrs) {
      // var(--x) не работает в presentation-атрибутах SVG — только через style.
      if (k === "fill" || k === "stroke") el.style[k] = attrs[k];
      else el.setAttribute(k, attrs[k]);
    }
    return el;
  }
  function niceMax(m) {
    if (m <= 0) return 1;
    var p = Math.pow(10, Math.floor(Math.log10(m)));
    for (var i = 0; i < 4; i++) { var c = [1, 2, 5, 10][i] * p; if (c >= m) return c; }
    return 10 * p;
  }

  // Бар-чарт одной серии: тонкие бары, 2px зазор, скруглённый data-end,
  // hover-тултип, выборочная прямая подпись на последнем баре.
  function barChart(mount, series, opts) {
    var root = document.getElementById(mount);
    var svg = svgEl("svg", { viewBox: "0 0 " + W + " " + H });
    var max = niceMax(Math.max.apply(null, series.map(function (d) { return d.value; })));
    var iw = W - PAD.l - PAD.r, ih = H - PAD.t - PAD.b;
    var bw = Math.min(36, iw / series.length - 2);
    // Сетка + ось Y (3 тика)
    for (var g = 0; g <= 3; g++) {
      var y = PAD.t + ih - ih * g / 3;
      svg.appendChild(svgEl("line", { x1: PAD.l, x2: W - PAD.r, y1: y, y2: y, stroke: v("--grid"), "stroke-width": 1 }));
      var lbl = svgEl("text", { x: PAD.l - 6, y: y + 3.5, "text-anchor": "end" });
      lbl.textContent = fmt(max * g / 3);
      svg.appendChild(lbl);
    }
    series.forEach(function (d, i) {
      var x = PAD.l + iw * (i + 0.5) / series.length - bw / 2;
      var h = max ? ih * d.value / max : 0;
      var r = Math.min(4, bw / 2, h);
      var y0 = PAD.t + ih;
      // Прямоугольник со скруглением только сверху (data-end), низ прижат к базовой линии.
      var p = "M" + x + "," + y0 + " V" + (y0 - h + r) +
              " Q" + x + "," + (y0 - h) + " " + (x + r) + "," + (y0 - h) +
              " H" + (x + bw - r) +
              " Q" + (x + bw) + "," + (y0 - h) + " " + (x + bw) + "," + (y0 - h + r) +
              " V" + y0 + " Z";
      var bar = svgEl("path", { d: p, fill: v("--s1") });
      bar.addEventListener("mousemove", function (evt) { showTip(evt, opts.tip(d)); });
      bar.addEventListener("mouseleave", hideTip);
      svg.appendChild(bar);
      var tx = svgEl("text", { x: x + bw / 2, y: H - 7, "text-anchor": "middle" });
      tx.textContent = d.label.replace(/^\d{4}-/, "");
      svg.appendChild(tx);
      if (i === series.length - 1 && h > 2) {
        var dl = svgEl("text", { x: x + bw / 2, y: y0 - h - 4, "text-anchor": "middle", "class": "dl" });
        dl.textContent = fmt(d.value);
        svg.appendChild(dl);
      }
    });
    svg.appendChild(svgEl("line", { x1: PAD.l, x2: W - PAD.r, y1: PAD.t + ih, y2: PAD.t + ih, stroke: v("--axis"), "stroke-width": 1 }));
    root.appendChild(svg);
  }

  // Линия одной серии (2px) с hover-маркерами.
  function lineChart(mount, series, opts) {
    var root = document.getElementById(mount);
    var svg = svgEl("svg", { viewBox: "0 0 " + W + " " + H });
    var max = opts.max || niceMax(Math.max.apply(null, series.map(function (d) { return d.value; })));
    var iw = W - PAD.l - PAD.r, ih = H - PAD.t - PAD.b;
    for (var g = 0; g <= 3; g++) {
      var y = PAD.t + ih - ih * g / 3;
      svg.appendChild(svgEl("line", { x1: PAD.l, x2: W - PAD.r, y1: y, y2: y, stroke: v("--grid"), "stroke-width": 1 }));
      var lbl = svgEl("text", { x: PAD.l - 6, y: y + 3.5, "text-anchor": "end" });
      lbl.textContent = Math.round(max * g / 3) + (opts.unit || "");
      svg.appendChild(lbl);
    }
    function px(i) { return PAD.l + iw * (i + 0.5) / series.length; }
    function py(val) { return PAD.t + ih - (max ? ih * val / max : 0); }
    var dAttr = series.map(function (d, i) { return (i ? "L" : "M") + px(i) + "," + py(d.value); }).join(" ");
    svg.appendChild(svgEl("path", { d: dAttr, fill: "none", stroke: v("--s1"), "stroke-width": 2, "stroke-linejoin": "round" }));
    series.forEach(function (d, i) {
      var dot = svgEl("circle", { cx: px(i), cy: py(d.value), r: 8, fill: "transparent" });
      var vis = svgEl("circle", { cx: px(i), cy: py(d.value), r: 3, fill: v("--s1"), stroke: v("--surface"), "stroke-width": 2 });
      dot.addEventListener("mousemove", function (evt) { showTip(evt, opts.tip(d)); });
      dot.addEventListener("mouseleave", hideTip);
      svg.appendChild(vis); svg.appendChild(dot);
      var tx = svgEl("text", { x: px(i), y: H - 7, "text-anchor": "middle" });
      tx.textContent = d.label.replace(/^\d{4}-/, "");
      svg.appendChild(tx);
    });
    var lastD = series[series.length - 1];
    var dl = svgEl("text", { x: px(series.length - 1), y: py(lastD.value) - 8, "text-anchor": "middle", "class": "dl" });
    dl.textContent = Math.round(lastD.value) + (opts.unit || "");
    svg.appendChild(dl);
    svg.appendChild(svgEl("line", { x1: PAD.l, x2: W - PAD.r, y1: PAD.t + ih, y2: PAD.t + ih, stroke: v("--axis"), "stroke-width": 1 }));
    root.appendChild(svg);
  }

  // Хитмап день×неделя: последовательная синяя рампа, ноль = поверхность.
  function heatmap(mount) {
    var root = document.getElementById(mount);
    var ramp = ["--seq0", "--seq1", "--seq2", "--seq3", "--seq4", "--seq5", "--seq6"].map(v);
    var rows = weeks.slice(-10);
    var cell = 26, gap = 2, lp = 64;
    var hH = rows.length * (cell + gap) + 26;
    var svg = svgEl("svg", { viewBox: "0 0 " + W + " " + hH });
    var maxD = 1;
    rows.forEach(function (w) {
      Object.keys(w.daily_sessions || {}).forEach(function (d) { maxD = Math.max(maxD, w.daily_sessions[d]); });
    });
    var dows = ["Сб", "Вс", "Пн", "Вт", "Ср", "Чт", "Пт"];
    dows.forEach(function (n, i) {
      var t = svgEl("text", { x: lp + i * (cell + gap) + cell / 2, y: 10, "text-anchor": "middle" });
      t.textContent = n; svg.appendChild(t);
    });
    rows.forEach(function (w, r) {
      var y = 18 + r * (cell + gap);
      var t = svgEl("text", { x: lp - 8, y: y + cell / 2 + 3.5, "text-anchor": "end" });
      t.textContent = w.week; svg.appendChild(t);
      var start = new Date(w.range.from);
      for (var i = 0; i < 7; i++) {
        var day = new Date(start.getTime() + i * 864e5).toISOString().slice(0, 10);
        var n = (w.daily_sessions || {})[day] || 0;
        var fill = n === 0 ? v("--surface") : ramp[Math.min(6, Math.floor(n / maxD * 6.99))];
        var rect = svgEl("rect", { x: lp + i * (cell + gap), y: y, width: cell, height: cell, rx: 4, fill: fill, stroke: v("--grid"), "stroke-width": 1 });
        (function (day, n) {
          rect.addEventListener("mousemove", function (evt) { showTip(evt, day + "<br>сессий: <b>" + n + "</b>"); });
          rect.addEventListener("mouseleave", hideTip);
        })(day, n);
        svg.appendChild(rect);
      }
    });
    root.appendChild(svg);
  }

  // --- Чарты ---
  barChart("ch-sessions", weeks.map(function (w) { return { label: w.week, value: w.sessions.total, w: w }; }), {
    tip: function (d) {
      return "<b>" + d.label + "</b><br>сессий: " + d.value +
        "<br>активных дней: " + d.w.active_days +
        "<br>пик: " + (d.w.peak.date || "–") + " (" + d.w.peak.sessions + ")";
    }
  });
  barChart("ch-tokens", weeks.map(function (w) { return { label: w.week, value: w.tokens.output, w: w }; }), {
    tip: function (d) {
      return "<b>" + d.label + "</b><br>output: " + fmt(d.value) +
        "<br>input: " + fmt(d.w.tokens.input) +
        "<br>cache read: " + fmt(d.w.tokens.cache_read) +
        "<br>turns: " + fmt(d.w.tokens.turns);
    }
  });
  lineChart("ch-tdd", weeks.map(function (w) {
    var t = w.tdd.test_edits, p = w.tdd.prod_edits;
    return { label: w.week, value: t + p ? 100 * t / (t + p) : 0, w: w };
  }), {
    max: 100, unit: "%",
    tip: function (d) {
      return "<b>" + d.label + "</b><br>тест-правки: " + d.w.tdd.test_edits +
        "<br>прод-правки: " + d.w.tdd.prod_edits +
        "<br>запуски тестов: " + d.w.tdd.test_runs;
    }
  });
  barChart("ch-friction", weeks.map(function (w) { return { label: w.week, value: w.friction.total, w: w }; }), {
    tip: function (d) {
      var kw = d.w.friction.by_keyword || {};
      var det = Object.keys(kw).map(function (k) { return k + ": " + kw[k]; }).join("<br>") || "–";
      return "<b>" + d.label + "</b><br>промтов-коррекций: " + d.value + "<br>" + det;
    }
  });
  barChart("ch-failures", weeks.map(function (w) { return { label: w.week, value: w.tools.failures_total, w: w }; }), {
    tip: function (d) {
      var det = (d.w.tools.failures_by_tool || []).map(function (f) { return f.name + ": " + f.count; }).join("<br>") || "–";
      return "<b>" + d.label + "</b><br>ошибок: " + d.value + "<br>" + det;
    }
  });
  heatmap("ch-heatmap");

  // --- Таблицы с дельтами ---
  function findCount(list, name) {
    for (var i = 0; i < (list || []).length; i++) if (list[i].name === name) return list[i].count;
    return null;
  }
  function topTable(mount, curList, prevList, header) {
    var rows = (curList || []).slice(0, 10).map(function (it) {
      var was = prevList ? findCount(prevList, it.name) : null;
      var d = was == null ? "новое" : (it.count - was >= 0 ? "+" + (it.count - was) : String(it.count - was));
      return "<tr><td class=name>" + it.name + "</td><td class=num>" + it.count + "</td><td class=num>" + d + "</td></tr>";
    }).join("");
    document.getElementById(mount).innerHTML =
      "<table><tr><th>" + header + "</th><th class=num>" + last.week + "</th><th class=num>Δ нед.</th></tr>" +
      (rows || "<tr><td colspan=3>нет данных</td></tr>") + "</table>";
  }
  topTable("t-tools", last.tools.top, prev && prev.tools.top, "Инструмент");
  topTable("t-subagents", last.subagents.top, prev && prev.subagents.top, "Субагент");
  var slashSkills = (last.slash_commands.top || []).concat(last.skills.top || []);
  var prevSlashSkills = prev ? (prev.slash_commands.top || []).concat(prev.skills.top || []) : null;
  topTable("t-slash", slashSkills, prevSlashSkills, "Команда / skill");
  var projRows = (last.tokens.by_project_top || []).map(function (p) {
    return "<tr><td class=name>" + p.project + "</td><td class=num>" + fmt(p.input + p.output) + "</td></tr>";
  }).join("");
  document.getElementById("t-projects").innerHTML =
    "<table><tr><th>Проект</th><th class=num>токены</th></tr>" + (projRows || "<tr><td colspan=2>нет данных</td></tr>") + "</table>";

  // --- Совет недели ---
  var rep = DATA.latest_report;
  var adv = document.getElementById("advice");
  if (rep && (rep.red_flags || rep.experiment)) {
    var html = "";
    if (rep.red_flags) html += "<h3>Красные флаги (" + rep.week + ")</h3>" + esc(rep.red_flags);
    if (rep.experiment) html += "<h3>Эксперимент недели</h3>" + esc(rep.experiment);
    adv.innerHTML = html;
  } else {
    adv.textContent = "Отчёт ещё не сгенерирован — запусти scripts/run-weekly-review.sh";
  }
  function esc(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").trim();
  }
})();
</script>
</body>
</html>
